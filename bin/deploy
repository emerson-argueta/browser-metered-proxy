#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"

# Parse -c <app> flag (e.g. bin/deploy -c my-other-app)
CONFIG_FLAG=""
APP_NAME="budget-clear"
while [[ $# -gt 0 ]]; do
  case "$1" in
    -c)
      APP_NAME="$2"
      CONFIG_FLAG="-c config/deploy.${2}.yml"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

# Load .env
if [ ! -f "$ROOT/.env" ]; then
  echo "ERROR: .env file not found at $ROOT/.env"
  exit 1
fi

set -a
source "$ROOT/.env"
set +a

# Verify required secrets are set
REQUIRED=(
  KAMAL_REGISTRY_PASSWORD
  SECRET_KEY_BASE
  ENCRYPTION_KEY
  JWT_SECRET
  PLAID_CLIENT_ID
  PLAID_SECRET
  STRIPE_SECRET_KEY
  STRIPE_WEBHOOK_SECRET
  STRIPE_PUBLISHABLE_KEY
)

for var in "${REQUIRED[@]}"; do
  if [ -z "${!var}" ]; then
    echo "ERROR: $var is not set in .env"
    exit 1
  fi
done

cd "$ROOT"

# Bootstrap installs Docker on the server (safe to run multiple times)
if [ "${1}" == "setup" ]; then
  echo "→ Bootstrapping server (installing Docker) for ${APP_NAME}..."
  kamal server bootstrap $CONFIG_FLAG
  echo "→ Running kamal setup..."
  kamal setup $CONFIG_FLAG
  exit 0
fi

# Credit management
# Usage: bin/deploy credits:grant EMAIL=friend@example.com AMOUNT=10
# Usage: bin/deploy credits:grant EMAIL=friend@example.com AMOUNT=10 -c my-other-app
# Usage: bin/deploy credits:list
# Usage: bin/deploy credits:balance EMAIL=friend@example.com
if [[ "${1}" == credits:* ]]; then
  task="${1}"
  shift
  kamal app exec $CONFIG_FLAG "bin/rails ${task} $*"
  exit 0
fi

echo "→ Deploying ${APP_NAME}-proxy..."
kamal deploy $CONFIG_FLAG

echo "→ Running migrations..."
kamal app exec $CONFIG_FLAG --reuse "bin/rails db:migrate"

echo "✓ Deploy complete"
