# Rails
SECRET_KEY_BASE=

# Auth — generate with: rails secret
JWT_SECRET=
JWT_EXPIRY_HOURS=720

# App name — shown as client_name in Plaid Link
APP_NAME=MyApp

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Stripe (for payment capabilities)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS — set to your browser app's origin
FRONTEND_ORIGIN=https://yourapp.pages.dev

# Encryption key for access tokens stored at rest (must be 32+ chars)
ENCRYPTION_KEY=

# Default markup percent (overridden per provider in config/providers.yml)
DEFAULT_MARKUP_PERCENT=2
